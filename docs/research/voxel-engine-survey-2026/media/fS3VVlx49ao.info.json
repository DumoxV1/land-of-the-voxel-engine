om/vi/fS3VVlx49ao/hqdefault.jpg", "height": 360, "width": 480, "preference": -7, "id": "34", "resolution": "480x360"}, {"url": "https://i.ytimg.com/vi_webp/fS3VVlx49ao/hqdefault.webp", "preference": -6, "id": "35"}, {"url": "https://i.ytimg.com/vi/fS3VVlx49ao/sddefault.jpg", "height": 480, "width": 640, "preference": -5, "id": "36", "resolution": "640x480"}, {"url": "https://i.ytimg.com/vi_webp/fS3VVlx49ao/sddefault.webp", "preference": -4, "id": "37"}, {"url": "https://i.ytimg.com/vi/fS3VVlx49ao/hq720.jpg", "preference": -3, "id": "38"}, {"url": "https://i.ytimg.com/vi_webp/fS3VVlx49ao/hq720.webp", "preference": -2, "id": "39"}, {"url": "https://i.ytimg.com/vi/fS3VVlx49ao/maxresdefault.jpg", "height": 1080, "width": 1920, "preference": -1, "id": "40", "resolution": "1920x1080"}, {"url": "https://i.ytimg.com/vi_webp/fS3VVlx49ao/maxresdefault.webp", "preference": 0, "id": "41"}], "thumbnail": "https://i.ytimg.com/vi/fS3VVlx49ao/maxresdefault.jpg", "description": "Building an infinite, high-resolution micro-voxel world usually requires a high-end dedicated GPU. This project is a strict exercise in extreme optimization, memory management, and data-oriented design, running entirely on a standard laptop with integrated graphics.\n\nBy applying principles from my background in Automation and Industrial Control Engineering, and utilizing AI as an architectural co-pilot, I structured this C++/OpenGL engine to bypass traditional hardware bottlenecks.\n\nHardware Used for this Recording:\n\nProcessor: 12th Gen Intel Core i5-1235U (1.30 GHz)\n\nRAM: 8GB\n\nGPU: Intel UHD Graphics (Integrated)\n\nCore Engine Features Shown:\n\nArchitecture: Custom Entity Component System (ECS) & Data-Oriented Design.\n\nRendering: 8x8x8 Micro-Voxel Grid, Greedy Meshing, and 3-Tier HLODs allowing a 24-chunk render distance.\n\nPhysics: Hybrid Cellular Automata handling finite fluid density and granular solid displacement (Sand, Gravel, Lava, Water) with AABB collisions.\n\nLighting: BFS Light Propagation, real-time RGB blending, and volumetric Godrays.\n\nExternal Pipeline: All procedural assets (like the 18 tree with growth stages, 2d textures) are generated externally via custom lightweight software (TextureDesigner, TreeDesigner, CreatureDesigner) and loaded as text data—Zero PNGs.\n\nI strongly advocate for the use of AI in software engineering. It served as an advanced compiler of ideas. It allowed me to rapidly iterate complex C++ algorithms and mathematical logic that would normally take a solo developer years to optimize.\n\ngithub.com/Saladmander99", "channel_id": "UCq1r8ckikSxOg2AgP5Hqrow", "channel_url": "https://www.youtube.com/channel/UCq1r8ckikSxOg2AgP5Hqrow", "duration": 293, "view_count": 177, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=fS3VVlx49ao", "categories": ["People & Blogs"], "tags": ["c++", "voxel", "opengl", "microvoxel", "game engine"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 3, "like_count": 13, "channel": "saladmander", "channel_follower_count": 3, "uploader": "saladmander", "uploader_id": "@benjaminjimenez2159", "uploader_url": "https://www.youtube.com/@benjaminjimenez2159", "upload_date": "20260615", "timestamp": 1781495901, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "fS3VVlx49ao", "fulltitle": "I Built a C++ Micro Voxel Engine using AI (Integrated Graphics, 60+ FPS, 8GB)", "duration_string": "4:53", "is_live": false, "was_live": false, "epoch": 1784131777, "asr": 22050, "filesize": 15185540, "format_id": "18", "format_note": "360p", "source_preference": -1, "fps": 30, "audio_channels": 2, "height": 360, "quality": 6.0, "has_drm": false, "tbr": 415.164, "filesize_approx": 15185